@*
Layout del panel. Lo usan las 14 pantallas de Admin
Barra lateral y barra superior van una sola vez aqui. El titulo lo pone cada vista
El usuario de la barra es dato de ejemplo, todavia no hay sesion ni view component de iniciales
Pendiente: Usuarios debe salir solo para el rol Administrador cuando exista la autorizacion
Pendiente: el boton de cambiar tema no hace nada y por eso queda deshabilitado
*@
@{
    var usuarioPanel = "Marcela Vega Rojas";
    var inicialesPanel = "MV";
    var rolPanel = "Administrador";

    // Marca el enlace del menu que corresponde a la pantalla abierta. Un grupo
    // de acciones comparte enlace: ProductoCrear tambien ilumina Productos
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    string? Actual(params string[] acciones) => acciones.Contains(accionActual) ? "page" : null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Html.Raw(ViewData["Titulo"]) | LEN Accessories</title>
    <link rel="stylesheet" href="~/lib/fonts/fonts.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/len.css">
</head>
<body>

    <a class="LenSalto" href="#contenido">Saltar al contenido</a>

    <div class="LenAdmin">

        <aside class="LenAdmin-Menu offcanvas-lg offcanvas-start" tabindex="-1" id="MenuAdmin" aria-labelledby="MenuAdminTitulo">
            <div class="offcanvas-header">
                <span class="LenSubtitulo" id="MenuAdminTitulo">Men&uacute;</span>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#MenuAdmin" aria-label="Cerrar"></button>
            </div>

            <div class="LenAdmin-Lateral">
                <a class="LenMarca LenAdmin-Marca" href="/Admin/Tablero">
                    <span class="LenMarca-Nombre">LEN</span>
                    <span class="LenMarca-Sub">Panel administrativo</span>
                </a>

                <nav class="LenAdmin-Nav" aria-label="Navegaci&oacute;n del panel">
                    <a href="/Admin/Tablero" aria-current="@Actual("Tablero")">
                        <i class="bi bi-speedometer2" aria-hidden="true"></i><span>Principal</span>
                    </a>

                    <a href="/Admin/Usuarios" aria-current="@Actual("Usuarios", "UsuarioDetalle")">
                        <i class="bi bi-people" aria-hidden="true"></i><span>Usuarios</span>
                    </a>

                    <a href="/Admin/Productos" aria-current="@Actual("Productos", "ProductoCrear", "ProductoEditar", "ProductoImagenes")">
                        <i class="bi bi-box-seam" aria-hidden="true"></i><span>Productos</span>
                    </a>
                    <a href="/Admin/Categorias" aria-current="@Actual("Categorias")">
                        <i class="bi bi-tags" aria-hidden="true"></i><span>Categor&iacute;as</span>
                    </a>
                    <a href="/Admin/Pedidos" aria-current="@Actual("Pedidos", "PedidoDetalle")">
                        <i class="bi bi-bag-check" aria-hidden="true"></i><span>Pedidos</span>
                    </a>
                    <a href="/Admin/Reportes" aria-current="@Actual("Reportes")">
                        <i class="bi bi-graph-up" aria-hidden="true"></i><span>Reportes</span>
                    </a>
                    <a href="/Admin/Pagos" aria-current="@Actual("Pagos")">
                        <i class="bi bi-credit-card" aria-hidden="true"></i><span>Pagos</span>
                    </a>
                    <a href="/Admin/Facturas" aria-current="@Actual("Facturas", "FacturaDetalle")">
                        <i class="bi bi-receipt" aria-hidden="true"></i><span>Facturas</span>
                    </a>
                </nav>

                <a class="LenAdmin-Usuario" href="/Admin/UsuarioDetalle">
                    <span class="LenAvatar">@inicialesPanel</span>
                    <span>
                        <strong>@usuarioPanel</strong>
                        <small>@rolPanel</small>
                    </span>
                </a>
            </div>
        </aside>


        <div class="LenAdmin-Principal">

            <div class="LenAdmin-Barra">
                <button class="LenAccion d-lg-none" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#MenuAdmin"
                        aria-controls="MenuAdmin" aria-label="Mostrar men&uacute;">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>

                <div class="ms-auto d-flex align-items-center gap-2">
                    <button class="LenAccion" type="button" disabled
                            aria-label="Cambiar tema" title="Cambiar tema: pendiente">
                        <i class="bi bi-moon-stars" aria-hidden="true"></i>
                    </button>

                    <div class="dropdown">
                        <button class="LenAdmin-Perfil dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="LenAvatar">@inicialesPanel</span>
                            <span class="d-none d-sm-inline">@usuarioPanel</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end LenDesplegable">
                            <li>
                                <a class="dropdown-item" href="/Admin/UsuarioDetalle">
                                    <i class="bi bi-person me-2" aria-hidden="true"></i>Perfil
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/Admin/UsuarioDetalle#Seguridad">
                                    <i class="bi bi-shield-lock me-2" aria-hidden="true"></i>Seguridad
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form class="m-0" method="post" action="/Acceso/CerrarSesion">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Cerrar sesi&oacute;n
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>


            <main class="LenAdmin-Contenido" id="contenido">
                @RenderBody()
            </main>


            <footer class="LenAdmin-Pie">
                <span>&copy; @DateTime.Now.Year LEN Accessories. Todos los derechos reservados.</span>
                <span>Panel administrativo</span>
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
