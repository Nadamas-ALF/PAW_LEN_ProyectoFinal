@*
Tarjeta de indicador del panel. Es la pieza mas repetida: 16 copias entre Tablero,
Pagos, Usuarios y Reportes
La columna la pone la vista, la parcial solo arma el article
El pie se vuelve enlace cuando trae url. Atencion lo pinta en rojo y no es
decoracion: avisa que hay algo que revisar
*@
@model IndicadorViewModel

<article class="LenIndicador @(Model.Atencion ? "LenIndicador--Atencion" : null)">

    @* Con icono el rotulo va dentro del encabezado para que queden en la misma
       linea. Sin icono no hace falta el envoltorio, y asi son los de Pagos *@
    @if (Model.Icono is not null)
    {
        <div class="LenIndicador-Encabezado">
            <span class="LenSubtitulo">@Html.Raw(Model.Rotulo)</span>
            <i class="bi bi-@Model.Icono" aria-hidden="true"></i>
        </div>
    }
    else
    {
        <span class="LenSubtitulo">@Html.Raw(Model.Rotulo)</span>
    }

    <span class="LenIndicador-Valor">@Html.Raw(Model.Valor)</span>

    @if (!string.IsNullOrEmpty(Model.Pie))
    {
        <span class="LenIndicador-Pie">
            @if (Model.UrlPie is not null)
            {
                <a class="LenEnlace" href="@Model.UrlPie">@Html.Raw(Model.Pie)</a>
            }
            else
            {
                @Html.Raw(Model.Pie)
            }
        </span>
    }
</article>
