@*
Confirmacion de una accion sin vuelta atras. Hace falta al quitar del carrito y al
desactivar producto categoria usuario o direccion, y al eliminar imagen o cancelar pedido
El boton de confirmar queda para que lo enganche el JavaScript. Cuando una pantalla
necesite enviarlo por formulario se le agrega esa variante
*@
@model ConfirmarModalViewModel

<div class="modal fade LenModal" tabindex="-1" id="@Model.Id" aria-labelledby="Titulo@(Model.Id)" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="Titulo@(Model.Id)">@Html.Raw(Model.Titulo)</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">@Html.Raw(Model.Cuerpo)</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="LenBoton LenBoton--Secundario" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="LenBoton LenBoton--Peligro" id="@Model.IdBotonConfirmar">@Html.Raw(Model.TextoConfirmar)</button>
            </div>
        </div>
    </div>
</div>
