@*
Acceso denegado (403). Layout _LayoutPublico. La muestra HomeController.Estado
Sale cuando hay sesion pero el rol no alcanza para la pantalla pedida
Reusa LenVacio--Pagina igual que Error. No dice si lo que se pidio existe
*@
@{
    ViewData["Titulo"] = "Acceso denegado";
}

<div class="LenVacio LenVacio--Pagina">
    <i class="bi bi-lock LenVacio-Icono" aria-hidden="true"></i>

    <h1 class="LenTitular">No tiene acceso a esta p&aacute;gina</h1>

    <p class="LenVacio-Texto">
        Su cuenta no tiene permiso para ver esta pantalla. Si cree que es un error,
        comun&iacute;quese con la administraci&oacute;n de la tienda.
    </p>

    <div class="d-flex flex-wrap gap-2 justify-content-center">
        <a class="LenBoton LenBoton--Principal" asp-controller="Home" asp-action="Index">Volver al inicio</a>
        <a class="LenBoton LenBoton--Secundario" href="/Publico/Catalogo">Ir al cat&aacute;logo</a>
    </div>
</div>
