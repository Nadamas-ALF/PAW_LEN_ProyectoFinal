@*
Pagina de error. Layout _LayoutPublico. Sale con un 500 del API o cuando la web falla
Nunca muestra el mensaje de la excepcion ni la consulta ni el rastro de pila
CodigoReferencia sera el IdError de TB_ERROR. Hoy va nulo y la linea no aparece
Pendiente decidir las pantallas 404 y 403, que reusan LenVacio--Pagina
*@
@model LEN_Web.Models.ErrorViewModel
@{
    ViewData["Titulo"] = "Ocurri&oacute; un error";
}

<div class="LenVacio LenVacio--Pagina">
    <i class="bi bi-exclamation-triangle LenVacio-Icono" aria-hidden="true"></i>

    <h1 class="LenTitular">Algo sali&oacute; mal</h1>

    <p class="LenVacio-Texto">
        No pudimos completar la acci&oacute;n. El problema qued&oacute; registrado y
        lo vamos a revisar. Puede intentarlo de nuevo en unos minutos.
    </p>

    @if (!string.IsNullOrEmpty(Model.CodigoReferencia))
    {
        <p class="LenVacio-Texto LenPequeno">
            C&oacute;digo de referencia: <code class="LenCodigo">@Model.CodigoReferencia</code>
        </p>
    }

    <div class="d-flex flex-wrap gap-2 justify-content-center">
        <a class="LenBoton LenBoton--Principal" asp-controller="Home" asp-action="Index">Volver al inicio</a>
        <a class="LenBoton LenBoton--Secundario" href="/Publico/Catalogo">Ir al cat&aacute;logo</a>
    </div>
</div>
