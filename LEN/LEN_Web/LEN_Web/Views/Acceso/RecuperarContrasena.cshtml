@*
Recuperar contrasena. Layout _LayoutPublico. Publica
Formulario: POST a /Acceso/RecuperarContrasena con antifalsificacion. Solo Correo
El aviso de resultado lo pinta el layout. El API responde 204 exista el correo o no (RQNF-SEC-005)
*@
@model LEN_Web.Models.RecuperarContrasenaViewModel
@{
    ViewData["Titulo"] = "Recuperar contrase&ntilde;a";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">

        <div class="mb-4">
            <h1 class="LenTitular">Recuperar contrase&ntilde;a</h1>
            <p class="LenTexto LenTexto--Guia mt-2 mb-0">Ingrese el correo electr&oacute;nico asociado a su cuenta.</p>
        </div>

        <form method="post" action="/Acceso/RecuperarContrasena" novalidate>
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label class="LenEtiqueta" asp-for="Correo">Correo electr&oacute;nico</label>
                <input asp-for="Correo" class="LenCampo" autocomplete="email" placeholder="correo@ejemplo.com" required>
                <span asp-validation-for="Correo" class="LenError"></span>
            </div>

            <button type="submit" class="LenBoton LenBoton--Principal LenBoton--Bloque">Enviar instrucciones</button>
        </form>

        <p class="LenAyuda mt-3">
            Revise la bandeja de entrada y la carpeta de correo no deseado.
        </p>

        <p class="mt-4 mb-0">
            &iquest;Record&oacute; su contrase&ntilde;a?
            <a class="LenEnlace" asp-controller="Acceso" asp-action="IniciarSesion">Volver al inicio de sesi&oacute;n</a>
        </p>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
