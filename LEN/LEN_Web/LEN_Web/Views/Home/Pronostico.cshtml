@model List<LEN_Web.Models.PronosticoViewModel>

<h1>Pronostico (desde el API)</h1>

<table class="table">
    <thead>
        <tr><th>Fecha</th><th>Temp C</th><th>Resumen</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model ?? [])
        {
            <tr>
                <td>@item.Date</td>
                <td>@item.TemperatureC</td>
                <td>@item.Summary</td>
            </tr>
        }
    </tbody>
</table>